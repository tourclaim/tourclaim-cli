{
  "name": "tourclaim",
  "version": "0.2.2",
  "description": "TourClaim by Copernican files trip cancellation and interruption claims against the travel insurance on a traveler's credit card. CLI for travelers and AI agents: saved intake, selected evidence, traveler authorization and claim status. Synthetic review mode as of October 2026.",
  "keywords": [
    "tourclaim",
    "copernican",
    "travel insurance",
    "trip cancellation",
    "trip interruption",
    "claims",
    "insurance claims",
    "credit card benefits",
    "ai agents",
    "agent tools",
    "cli",
    "travel platforms",
    "travel claims",
    "credit card travel insurance"
  ],
  "homepage": "https://github.com/tourclaim/tourclaim-cli#readme",
  "bugs": {
    "url": "https://github.com/tourclaim/tourclaim-cli/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tourclaim/tourclaim-cli.git"
  },
  "license": "MIT",
  "author": "Copernican",
  "type": "module",
  "bin": {
    "tourclaim": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "AGENTS.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE",
    "MCP.md",
    "server.json",
    "llms.txt"
  ],
  "engines": {
    "node": ">=18.3"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "npm run build && node scripts/test.mjs",
    "mock": "node scripts/test.mjs --build-only && node .build/test/mock-main.js",
    "version": "node scripts/sync-version.mjs && git add src/version.ts",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^18.19.130",
    "typescript": "^5.9.3"
  }
}
